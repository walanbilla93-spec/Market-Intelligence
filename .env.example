# This service is independent. Never place New Orayan/Bybit trading credentials here.
MI_DATA_DIR=/data
MI_CONFIG=config.json
MI_HTTP_TIMEOUT_SECONDS=12
MI_MAX_RESPONSE_BYTES=4000000
MI_POLL_SECONDS=900
MI_QUEUE_CAPACITY=128

# Optional FRED API key for DGS10, DTWEXBGS, SP500, VIXCLS.
FRED_API_KEY=

# Optional observer only. A Gemini web subscription does not imply API quota.
# Zero-cost default: no Gemini request is made unless this is explicitly true.
MI_GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MI_GEMINI_INTERVAL_SECONDS=1800
MI_GEMINI_EVENT_TRIGGER=true
GEMINI_TIMEOUT_SECONDS=30
GEMINI_TOTAL_TIMEOUT_SECONDS=45
GEMINI_MAX_QUEUE=2
GEMINI_MAX_ATTEMPTS=2
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_ROUTINE_THINKING_LEVEL=medium
GEMINI_EVENT_THINKING_LEVEL=high
GEMINI_MAX_INPUT_CHARS=24000
GEMINI_MAX_REQUEST_BYTES=65536
GEMINI_MAX_INPUT_AGE_SECONDS=1200
GEMINI_FAILURE_THRESHOLD=3
GEMINI_CIRCUIT_OPEN_SECONDS=900

# Optional read-only phone export UI. Keep disabled unless port 8080 is deliberately configured.
# Set MI_EXPORT_TOKEN only as a protected runtime secret, never in this file or Git.
MI_EXPORT_UI_ENABLED=false
MI_EXPORT_UI_PORT=8080
MI_EXPORT_REQUIRE_HTTPS=true
MI_EXPORT_SESSION_SECONDS=3600
MI_EXPORT_REQUEST_TIMEOUT_SECONDS=120
MI_EXPORT_MAX_INPUT_MIB=192
MI_EXPORT_MAX_ZIP_MIB=192
MI_EXPORT_TMP_QUOTA_MIB=384
MI_EXPORT_MAX_HTTP_THREADS=8

