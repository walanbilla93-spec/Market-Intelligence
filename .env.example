# This service is independent. Never place New Orayan/Bybit trading credentials here.
MI_DATA_DIR=/data
MI_CONFIG=config.json
MI_HTTP_TIMEOUT_SECONDS=12
MI_MAX_RESPONSE_BYTES=4000000
MI_POLL_SECONDS=900
MI_QUEUE_CAPACITY=128

# Optional FRED API key for DGS10, DTWEXBGS, SP500, VIXCLS.
FRED_API_KEY=

# Optional observer only. A Gemini web subscription does not imply API quota.
# Zero-cost default: no Gemini request is made unless this is explicitly true.
MI_GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MI_GEMINI_INTERVAL_SECONDS=1800
MI_GEMINI_EVENT_TRIGGER=true
GEMINI_TIMEOUT_SECONDS=8
GEMINI_MAX_QUEUE=2
GEMINI_MAX_ATTEMPTS=2
GEMINI_MAX_OUTPUT_TOKENS=1200
GEMINI_MAX_INPUT_CHARS=60000
GEMINI_MAX_INPUT_AGE_SECONDS=1200
GEMINI_FAILURE_THRESHOLD=3
GEMINI_CIRCUIT_OPEN_SECONDS=900

